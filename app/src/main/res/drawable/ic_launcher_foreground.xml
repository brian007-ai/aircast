<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon: a glass droplet with a sound-wave core.

  The droplet is a point at (54, 24) easing into a circle of radius 20 centred
  at (54, 64). The bars are strokes with round caps rather than rounded
  rectangles, which keeps every end true regardless of the icon mask.

  Everything stays inside the 72 dp safe circle, so no mask crops the drop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#5AC8FA"
        android:pathData="M54,24
            C54,24 34,50 34,64
            a20,20 0 0,0 40,0
            C74,50 54,24 54,24 Z" />

    <path
        android:pathData="M47,61 L47,75"
        android:strokeColor="#07121F"
        android:strokeWidth="4.4"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,54 L54,73"
        android:strokeColor="#07121F"
        android:strokeWidth="4.4"
        android:strokeLineCap="round" />

    <path
        android:pathData="M61,61 L61,75"
        android:strokeColor="#07121F"
        android:strokeWidth="4.4"
        android:strokeLineCap="round" />
</vector>
